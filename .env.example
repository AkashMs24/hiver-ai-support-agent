# Hiver Support Agent Environment Configuration
# Copy this file to .env and fill in your API keys

# === LLM API Keys (at least one required) ===
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# === Model Configuration ===
# Groq models: llama-3.1-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_MODEL=llama-3.1-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# Gemini models: gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-1.5-flash

# === Pipeline Configuration ===
# Number of conversations to process (keep small for fast reproduction)
SUBSAMPLE_SIZE=5000
# Brand to analyze
BRAND=AppleSupport
# Confidence threshold for LLM fallback in intent classification
INTENT_CONFIDENCE_THRESHOLD=0.6
# Escalation sensitivity (higher = more escalations)
ESCALATION_THRESHOLD=0.55
